# QED-Net Environment Variables
# Copy this file to .env and fill in your values

# MLflow
MLFLOW_TRACKING_URI=file:///app/mlruns

# Redis (for Celery)
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
DASHBOARD_PORT=8501

# Quantum backend (optional)
# IBM_QUANTUM_TOKEN=your_ibm_token_here
# IBM_QUANTUM_INSTANCE=ibm-q/open/main

# Logging
LOG_LEVEL=INFO